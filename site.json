{
  "name": "The Cruise Detective",
  "domain": "https://www.thecruisedetective.com",
  "languages": [
    "en",
    "fr",
    "de",
    "es",
    "it",
    "nl",
    "pl",
    "ro",
    "ja",
    "cs",
    "pt"
  ],
  "images": {
    "allowed_hosts": [
      "aws-tiqets-cdn.imgix.net",
      "images.unsplash.com",
      "www.facebook.com",
      "www.thecruisedetective.com"
    ]
  },
  "local_checks": [
    "scripts/sync_layout.py --check",
    "scripts/fix_affiliate_rel.py --check"
  ],
