{
  "name": "The Cruise Detective",
  "domain": "https://www.thecruisedetective.com",
  "languages": [
    "en",
    "fr",
    "de",
    "es",
    "it",
    "nl",
    "pl",
    "ro",
    "ja",
    "cs",
    "pt"
  ],
  "images": {
    "allowed_hosts": [
      "aws-tiqets-cdn.imgix.net",
      "images.unsplash.com",
      "www.facebook.com",
      "www.thecruisedetective.com"
    ]
  },
  "local_checks": [
    "scripts/sync_layout.py --check",
    "scripts/fix_affiliate_rel.py --check"
  ],
  "runtime": {
    "shared": true
  },
  "affiliate": {
    "conditional_hosts": {
      "fareharbor.com": {
        "ref": "cruisedetective-asn"
      }
    },
    "json": [
      "i18n/*.json"
    ],
    "skip": [
      "api/"
    ]
  },
  "photo_order": {
    "slot": "rebuild"
  },
  "listicle": {
    "pages": [
      "seine-river-cruises-paris/index.html",
      "thames-river-cruises-london/index.html",
      "dinner-cruises-paris/index.html",
      "canal-cruises-amsterdam/index.html",
      "new-years-eve-cruises-paris/index.html",
      "private-cruises-paris/index.html",
      "prague-river-cruises/index.html"
    ]
  }
}
