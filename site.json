    "shared": true
  },
  "affiliate": {
    "conditional_hosts": {
      "fareharbor.com": {
        "ref": "cruisedetective-asn"
      }
    },
    "json": [
      "i18n/*.json"
    ],
    "skip": [
      "api/"
    ]
  },
  "photo_order": {
    "slot": "rebuild"
  },
  "listicle": {
    "pages": [
      "seine-river-cruises-paris/index.html",
      "thames-river-cruises-london/index.html",
      "dinner-cruises-paris/index.html",
      "canal-cruises-amsterdam/index.html",
      "new-years-eve-cruises-paris/index.html",
      "private-cruises-paris/index.html",
      "prague-river-cruises/index.html",
      "douro-river-cruises-porto/index.html",
      "berlin-boat-tours/index.html",
      "vistula-river-cruises-warsaw/index.html",
      "bateaux-mouches-vs-bateaux-parisiens-dinner-cruise-side-by-side-comparison/index.html"
    ],
    "translate": {
      "topic": "river, canal and dinner cruises in Paris, London, Amsterdam, Prague, Porto, Berlin and Warsaw",
      "names": [
        "GetYourGuide",
        "Tiqets",
        "Viator",
        "Tripadvisor",
        "The Cruise Detective"
      ],
      "landmarks": [
        "Eiffel Tower",
        "Tower Bridge",
        "Charles Bridge",
        "Pont Neuf"
      ]
    }
  }
